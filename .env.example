# Deriv — Doug.AI (NUNCA commite .env com token real)
# Copie para .env na raiz:  copy .env.example .env

# App ID público para demo (1089) ou o seu em api.deriv.com
DERIV_APP_ID=1089

# Token de API — conta DEMO (home.deriv.com → API token)
# Deixe vazio para ticks públicos com DOUG_MODE=demo
DERIV_API_TOKEN=

# Modo operacional: demo | live | paper
DOUG_MODE=demo

# Live trading — SEMPRE false por padrão; nunca auto-habilitar
DERIV_LIVE_ENABLED=false

# Diretório de dados do dashboard (Docker usa /app/data)
DOUG_DATA_DIR=data
# Safe Deriv API integration (mock-first)
DERIV_ENDPOINT=ws.derivws.com
DERIV_DEFAULT_SYMBOL=R_100
DERIV_CURRENCY=USD
DERIV_TIMEOUT_SECONDS=10
DERIV_MOCK_ENABLED=true
